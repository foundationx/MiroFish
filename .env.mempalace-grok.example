# MiroFish + MemPalace + xAI Grok. Copy to .env (git-ignored).
# Leave LLM_API_KEY / LLM_BOOST_API_KEY OUT of the file: scripts/mempalace_grok_backend.sh
# maps them from $XAI_API_KEY at runtime, so no secret ever lands on disk.
# (config.py loads .env with override=True, so a key written here would win.)
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL_NAME=grok-4.3
LLM_BOOST_BASE_URL=https://api.x.ai/v1
LLM_BOOST_MODEL_NAME=grok-4.20-0309-non-reasoning

GRAPH_MEMORY_BACKEND=mempalace
# MEMPALACE_DATA_DIR=/absolute/path/to/mempalace-data   # default: backend/uploads/mempalace
MEMPALACE_EXTRACT_WORKERS=4
# Model used only for graph extraction (default: LLM_MODEL_NAME). A non-reasoning model drained post-simulation ingestion in ~11 s vs ~4 min with grok-4.3.
MEMPALACE_EXTRACT_MODEL=grok-4.20-0309-non-reasoning
